{
  "configurations": [
    {
      "name": "Linux ARM",
      "includePath": [
        "${workspaceFolder}/inc",
        "${workspaceFolder}/src",
        "${workspaceFolder}/**"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/inc",
          "${workspaceFolder}/src",
          "${workspaceFolder}/**"
        ],
        "limitSymbolsToIncludedHeaders": false,
        "databaseFilename": "${workspaceFolder}/.vscode/browse-fixed.vc.db"
      },
      "defines": [
        "DEBUG"
      ],
      "compilerPath": "",
      "compilerArgs": [
        "-I${workspaceFolder}/inc",
        "-I${workspaceFolder}/src",
        "-DDEBUG"
      ],
      "cStandard": "c11",
      "intelliSenseMode": "linux-gcc-arm",
      "compileCommands": "${workspaceFolder}/compile_commands.json"
    }
  ],
  "version": 4
}
